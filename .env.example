# Configuration SMTP pour le formulaire de contact
# Copier ce fichier en .env et remplir les valeurs réelles.
# Le .env doit être uploadé manuellement dans /home/biarritzburo/public_html/
# Il est protégé par .gitignore (jamais commit) et par .htaccess (jamais accessible en HTTP).

SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=changeme
SMTP_SECURE=tls

MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="BiarritzBuro"
MAIL_TO=contact@example.com
MAIL_TO_NAME="BiarritzBuro"
MAIL_SUBJECT_PREFIX="[Site] "
